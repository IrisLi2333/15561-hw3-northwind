 "text": {
  "monthly": {
   "title": "Monthly revenue climbed from $27.9K in July 1996 to $123.8K in April 1998",
   "sub": "Net revenue per month, in US$ thousands, July 1996 to April 1998\nBlue columns: revenue in the month\nOrange line: 3-month rolling average",
   "src": "Column and line chart. Data: Orders, Order Details. n = 22 months",
   "about": "Net revenue for each month, with a 3-month rolling average that smooths out single large orders.",
   "takeaway": "The 3-month average rose from $26.6K in September 1996 to $109.4K in April 1998. Each month from January to April 1998 set a new high. January to April 1998 averaged $105.6K a month, 2.1× the 1997 monthly average. No single order exceeded 27% of its month's revenue, so the climb comes from many orders."
  },
  "bridge": {
   "drivers": {
    "title": "Customers ordering more often explain 74% of the revenue increase",
    "sub": "Change in net revenue by driver, in US$ thousands, Jul 1996–Apr 1997 vs Jul 1997–Apr 1998\nRevenue = active customers × orders per customer × average order value\nDark blue: total revenue in each period\nBlue: increase from each driver",
    "takeaway": "Purchase frequency did most of the work: orders per customer rose from 3.4 to 5.5, adding $263.6K. Active customers grew from 80 to 87 and average order value from $1,452 to $1,582, together adding $94.9K."
   },
   "markets": {
    "title": "USA, Germany and Brazil brought 57% of the increase; 18 of 21 markets grew",
    "sub": "Change in net revenue by customer country, in US$ thousands, Jul 1996–Apr 1997 vs Jul 1997–Apr 1998\nDark blue: total revenue in each period\nBlue: markets that grew\nOrange: markets that declined",
    "takeaway": "USA, Germany and Brazil added $205.2K, 57% of the increase. 18 of 21 markets grew. The 3 declining markets lost $8.0K combined, 2.2% of the increase."
   },
   "categories": {
    "title": "All 8 categories grew; Dairy Products added the most and Seafood grew fastest (+193%)",
    "sub": "Change in net revenue by product category, in US$ thousands, Jul 1996–Apr 1997 vs Jul 1997–Apr 1998\nDark blue: total revenue in each period\nBlue: categories that grew",
    "takeaway": "Every category grew. Dairy Products, Beverages and Seafood added $196.1K, 55% of the increase. The smallest gain, Condiments, was still $24.9K (+68%)."
   },
   "src": "Waterfall chart. Data: Orders, Order Details, Customers, Product, Categories",
   "about": "A waterfall chart of the revenue increase. Switch the view to see it by driver, market or category."
  },
  "cohorts": {
   "title": "Customers won in 1996 still brought 87% of revenue in 1998 Q1",
   "sub": "Net revenue per complete quarter, in US$ thousands, 1996 Q3 to 1998 Q1\nBlue: 1996 Q3 cohort (42 customers)\nOrange: 1996 Q4 cohort (24 customers)\nDark blue: 1997 Q1 cohort (10 customers)\nLight orange: 1997 Q2 cohort (8 customers)\nLight blue: 1997 Q3 or later cohort (5 customers)",
   "src": "Stacked column chart. Data: Orders, Order Details. n = 89 customers",
   "about": "Revenue in each complete quarter, split by when each customer placed their first order.",
   "takeaway": "Customers won in 1996 brought 87% of revenue in 1998 Q1. The 1996 Q3 cohort's quarterly revenue rose from $79.7K to $186.2K, 2.3× in 6 quarters, while the 5 customers who joined from 1997 Q3 onward brought 3%. Growth came from the established base buying more, which matches the driver split in Figure 1.2."
  },
  "pareto": {
   "title": "The top 10 customers bring 49.6% of revenue, up from 47.4%",
   "sub": "Cumulative share of net revenue, customers ranked from largest to smallest\nBlue line: Jul 1997–Apr 1998\nLight blue line: Jul 1996–Apr 1997\nOrange dot: where the top 10 customers end\nDotted diagonal: every customer the same size",
   "src": "Pareto curve. Data: Orders, Order Details. n = 87 customers",
   "about": "A Pareto curve of customer revenue in both periods.",
   "takeaway": "32 of 87 customers (37%) bring 80% of revenue. The top 10 customers' share rose from 47.4% to 49.6%, and the largest customer's from 8.6% to 9.9%. Revenue is concentrating gradually as the business grows."
  },
  "finding": "Net revenue grew 90% to $757.9K. Purchase frequency drove it: orders per customer rose from 3.4 to 5.5, which explains 74% of the increase, while the customer base and average order value each grew about 9%. The growth is broad: all 8 categories, 18 of 21 markets and 62 of 89 customers grew. Concentration edged up, with the top 10 customers at 49.6% of revenue and USA, Germany and Brazil supplying 57% of the increase.",
  "implication": "The growth rests on established customers buying more often, which gives management a solid base for planning. The main exposure is concentration: about half of revenue rests on ten accounts and three markets carry most of the increase. Assign clear ownership of the top accounts and track orders per customer as the leading indicator of momentum.",
  "method": [
   [
    "Comparison periods",
    "Jul 1996–Apr 1997 against Jul 1997–Apr 1998. The data spans 22 complete months, two short of the 24 a full-year comparison needs. July to April is the longest pair of periods covering the same months of the year, which holds seasonal effects equal."
   ],
   [
    "Net revenue",
    "Unit price × quantity × (1 − discount), summed over order lines. Freight is excluded."
   ],
   [
    "Revenue drivers",
    "Revenue = active customers × orders per customer × average order value. An active customer placed at least one order in the period. Orders per customer = orders ÷ active customers. Average order value = net revenue ÷ orders."
   ],
   [
    "Driver contribution",
    "A driver's share of the increase = log of its growth ratio ÷ log of the revenue growth ratio. Logs turn the product into a sum, so the three shares add to 100%; each share × the total increase gives the driver's dollar amount."
   ],
   [
    "Waterfall chart",
    "Starts from the earlier period's revenue, adds each component's change as a step, and ends at the later period's revenue."
   ],
   [
    "Customer cohort",
    "Customers grouped by the quarter of their first order in the data. The 1996 Q3 cohort includes customers who started before the data begins."
   ],
   [
    "Pareto curve",
    "Customers ranked from largest to smallest. The curve plots the cumulative share of revenue against the cumulative share of customers; the more it bows upward, the more concentrated revenue is."
   ]
  ]
 }
