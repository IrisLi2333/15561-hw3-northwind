 "text": {
  "bridge": {
   "title": "Existing customers added $376.3K; 25 contracting accounts gave back $61.2K",
   "sub": "Change in net revenue by customer group, in US$ thousands, Jul 1996–Apr 1997 vs Jul 1997–Apr 1998\nDark blue: total revenue in each period\nBlue: increase (new and expanding customers)\nOrange: decrease (contracting and lost customers)\nNumber in brackets: customers in the group",
   "src": "Waterfall chart. Data: Orders, Order Details. n = 89 customers",
   "about": "The revenue change split by customer group, as a waterfall.",
   "takeaway": "Existing customers buying more (53) added $376.3K, and 9 new customers added $43.7K. Contraction among 25 customers cost $61.2K, about 247× the $248 lost when 2 customers left. The main retention risk is customers who stay and spend less."
  },
  "products": {
   "title": "6 of 77 products declined, all inside growing categories, losing $6.3K combined",
   "sub": "Change in net revenue by product, in US$ thousands, Jul 1996–Apr 1997 vs Jul 1997–Apr 1998\nShown: the eight largest gains and every decline\nBlue: products that grew\nOrange: products that declined",
   "src": "Diverging bar chart. Data: Order Details, Product. n = 77 products",
   "about": "The products with the largest gains, and every product that declined.",
   "takeaway": "Only 6 of 77 products declined, losing $6.3K combined, and all 6 sit in categories that grew overall. The largest decline was Tofu (−$2.4K); the largest gain, Thüringer Rostbratwurst, added $35.0K. Product decline is a small risk next to customer contraction ($61.2K)."
  },
  "markets": {
   "title": "3 markets declined; lower spend per customer explains 71% of the drop",
   "sub": "Change in net revenue of each declining market, in US$ thousands, Jul 1996–Apr 1997 vs Jul 1997–Apr 1998\nBlue: effect of the change in the number of active customers\nOrange: effect of the change in spend per customer\nGrey text: the customer behind most of the decline",
   "src": "Stacked bar chart. Data: Orders, Order Details, Customers. n = 3 declining markets",
   "about": "Each declining market's change, split into the effect of fewer customers and the effect of lower spend per customer.",
   "takeaway": "Mexico, Denmark and Finland lost $8.0K combined, 2.2% of the total increase. Lower spend per customer explains 71% of it, and only Mexico lost active customers. In each market a single account drives the drop."
  },
  "cohort": {
   "title": "In a typical later quarter, 65% of a customer cohort orders again",
   "sub": "Share of each customer cohort that ordered again in each later quarter\nCohort: customers grouped by the quarter of their first order in the data\nDarker blue: higher share\nAsterisk (*): quarter with orders to 6 May 1998 only\nCohorts with fewer than 8 customers are left out",
   "src": "Cohort heatmap. Data: Orders. Cohorts of 8 or more customers",
   "about": "Retention by cohort: the share of each group of customers ordering again in each later quarter.",
   "takeaway": "In a typical later quarter 65% of a cohort orders again, with no decline in later quarters: 86% of the 1996 Q3 cohort ordered 6 quarters after joining. This steady retention is what lets the early cohorts in Figure 1.4 keep growing."
  },
  "rhythm": {
   "title": "9 customers are overdue against their own order rhythm, with $53.8K of trailing revenue at stake",
   "sub": "Each dot is one customer with 3 or more orders\nAcross: usual days between orders (median)\nUp: days since the last order, at 6 May 1998\nDot size: revenue in the last 12 months\nBlue dot: ordering on rhythm\nOrange dot: overdue, more than 2× the usual gap\nDashed orange line: 2× the usual gap\nDotted grey line: 1× the usual gap",
   "src": "Scatter and table. Data: Orders, Order Details. n = 86 customers",
   "about": "Each customer's time since the last order against their own usual gap. Dots above the dashed line are overdue.",
